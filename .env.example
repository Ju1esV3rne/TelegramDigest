# Скопируй этот файл в .env и заполни реальными значениями.
# .env НИКОГДА не коммитится в Git (уже добавлен в .gitignore).

# --- Telegram API (https://my.telegram.org -> API development tools) ---
TELEGRAM_API_ID=12345678
TELEGRAM_API_HASH=0123456789abcdef0123456789abcdef

# Номер телефона аккаунта в международном формате (только для авторизации).
# Можно оставить пустым — Telethon спросит при первом запуске.
TELEGRAM_PHONE=+79001234567

# --- OpenRouter (https://openrouter.ai/keys) ---
# Ключ OpenRouter. Приложение использует только этот ключ.
OPENROUTER_API_KEY=
# Модель для сводки. openrouter/free — роутер по бесплатным моделям (лимит
# 100 запросов в сутки без кредитов). Можно указать конкретную платную модель.
OPENROUTER_MODEL=openrouter/free

# --- Telegram Bot API ---
# Токен бота от @BotFather.
TELEGRAM_BOT_TOKEN=
# ID чата-получателя сводки (например -1001234567890).
TELEGRAM_TARGET_CHAT_ID=-1001234567890
